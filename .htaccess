# EuropaSoft - configuration Apache (OVH mutualise, deploiement Git)
# Voir docs/PLATEFORMES.md

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

RewriteEngine On

# 1. HTTPS force + domaine canonique sans www (canonical et sitemap visent https://europasoft.eu/)
RewriteCond %{SERVER_PORT} 80 [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://europasoft.eu%{REQUEST_URI} [R=301,L]

# 2. Fichiers caches jamais servis (reponse 404), .well-known reste accessible (SSL)
#    Seul le contenu de public/ est deploye : docs/, scripts/ et graphify-out/ n'arrivent jamais sur OVH.
RewriteRule (^|/)\.(?!well-known) - [R=404,L]

# 3. Types MIME
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest

# 4. Cache : long sur les polices, un jour sur les images, revalidation sur le reste
<IfModule mod_headers.c>
<FilesMatch "\.woff2$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(svg|png|jpe?g|webp|ico)$">
Header set Cache-Control "public, max-age=86400"
</FilesMatch>
# CSS et JS revalides a chaque visite (304 si inchanges) : une mise en ligne s'applique tout de suite
<FilesMatch "\.(css|js|html|json|webmanifest|xml|txt)$">
Header set Cache-Control "no-cache"
</FilesMatch>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
